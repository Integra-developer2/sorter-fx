<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="920.0" spacing="20.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.views.viewStockFile">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableView" editable="true" prefHeight="920.0">
            <columns>
                <TableColumn fx:id="firstBarcode" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                             text="PRIMO BARCODE"/>
                <TableColumn fx:id="lastBarcode" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                             text="ULTIMO BARCODE"/>
                <TableColumn fx:id="stockLabel" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                             text="SCATOLO"/>
                <TableColumn fx:id="obs" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="PEDANA"/>
                <TableColumn fx:id="group" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="GRUPPO"/>
                <TableColumn fx:id="progStart" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                             text="PROG.INI"/>
                <TableColumn fx:id="progEnd" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                             text="PROG.FIN"/>
                <TableColumn fx:id="logic" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="LOGICA"/>
                <TableColumn fx:id="prefix" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="PREFISSO"/>
                <TableColumn fx:id="stockNumber" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                             text="PACCO"/>
                <TableColumn fx:id="agency" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="AGENZIA"/>
                <TableColumn fx:id="cassetto" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                             text="CASSETTO"/>
                <TableColumn fx:id="pacco" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="PACCO"/>
                <TableColumn fx:id="error" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="ANOMALIA"/>
                <TableColumn fx:id="deleteColumn" text="ELIMINA RIGA"/>
            </columns>
        </TableView>
    </VBox>
    <VBox alignment="CENTER_RIGHT" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_RIGHT" prefHeight="27.0" prefWidth="887.0">
            <Button fx:id="btnForward" alignment="CENTER" minWidth="263.0" prefHeight="59.0"
                    style="-fx-background-color: #005075;" text="AVANTI" textFill="WHITE">
                <cursor>
                    <Cursor fx:constant="HAND"/>
                </cursor>
                <font>
                    <Font name="Arial Black" size="20.0"/>
                </font>
            </Button>
        </HBox>
    </VBox>
</VBox>
